TOKEN_DISCORD=your_discord_bot_token
GROQ_API_KEY=your_groq_api_key
GROQ_CHAT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_CHAT_MODEL=meta-llama/llama-prompt-guard-2-86m
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
DATABASE_PATH=/app/data/cipereusz-premium.sqlite3
RANDOM_REPLY_CHANCE=0.05
IMAGE_REPLY_CHANCE=0.15
RANDOM_IMAGE_CHANCE=0.2
RECENT_IMAGES_MAX=80
MAX_IMAGE_BYTES=6291456
IDLE_SECONDS=7200
MEMORY_BATCH_SIZE=20
MEMORY_RECENT_MESSAGES=24
MENTION_REPLY_LIMIT=220
ADMIN_USER_ID=321309474667233284
BOT_PING_ID=1437781243751301264
BOT_PING_CHANCE=0.05
RANDOM_PING_ENABLED=1
RANDOM_PING_MIN_SECONDS=600
RANDOM_PING_MAX_SECONDS=36000
RANDOM_PING_START_HOUR=12
RANDOM_PING_END_HOUR=23
TZ=Europe/Warsaw

# --- kanal glosowy (/dolacz, /wyjdz) ---
VOICE_ENABLED=1
# jesli 1, tylko ADMIN_USER_ID moze uzyc /dolacz

VOICE_ADMIN_ONLY=0
# whisper na Groq - obecnie NIEUZYWANE (odbior audio jest wylaczony, patrz
# README, zostawione na wypadek gdyby py-cord/discord kiedys naprawili DAVE)

GROQ_STT_MODEL=whisper-large-v3-turbo
VOICE_STT_LANGUAGE=pl
# slowa-klucze (przecinek) - odbior GLOSU jest wylaczony (DAVE), wiec bot
# wykrywa je w tekscie napisanym na kanale gdzie uzyto /dolacz. rozpoznawane
# tez w odmianie przez przypadki
VOICE_TRIGGER_WORDS=cipek,cipereusz

# UWAGA: Groq TTS (playai-tts) obsluguje tylko angielski i arabski, wiec do
# polskiej mowy uzywamy darmowego edge-tts (Microsoft) - lista glosow:
# edge-tts --list-voices | grep pl-PL
VOICE_TTS_VOICE=pl-PL-MarekNeural
VOICE_TTS_RATE=+0%

# --- logowanie ---
LOG_LEVEL=INFO
LOG_FILE=./logs/cipereusz.log

# --- teczka / pamiec ---
# ile wiadomosci maksymalnie czeka w kolejce na ekstrakcje do teczki, zanim
# zaczniemy odrzucac najstarsze (np. przy dluzszej awarii api groq)
MEMORY_PENDING_CAP=300
